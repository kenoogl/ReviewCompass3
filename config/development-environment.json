{
  "environment_id": "RC3-DEVELOPMENT-VENV",
  "environment_version": 1,
  "base_python": "python3",
  "venv_path": ".venv",
  "venv_python": ".venv/bin/python3",
  "python": {
    "minimum_version": "3.9",
    "maximum_exclusive_version": "3.10"
  },
  "pytest": {
    "exact_version": "8.4.2"
  },
  "required_imports": {
    "platformdirs": "4.4.0",
    "PyYAML": "6.0.3"
  },
  "lock": {
    "path": "constraints/development-py39.txt",
    "sha256": "1307ed9075ddcc312697d18114b8f5b594796f047ab5df586e7a7b448058c8f2"
  },
  "toolchain_command": [
    ".venv/bin/python3",
    "-m",
    "pip",
    "install",
    "--constraint",
    "constraints/development-py39.txt",
    "pip==26.0.1",
    "setuptools==80.9.0",
    "wheel==0.45.1"
  ],
  "install_command": [
    ".venv/bin/python3",
    "-m",
    "pip",
    "install",
    "--constraint",
    "constraints/development-py39.txt",
    "--no-build-isolation",
    "--editable",
    ".[development]"
  ]
}
