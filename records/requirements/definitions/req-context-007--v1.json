  "feature_id": "FEAT-REVIEW-CONTEXT",
  "statement": "システムはContext構成と検査で生じた確認済み成果、失敗履歴および診断を共有保存境界を介して部分書込みや機微情報の漏えいを防ぎ再起動後に照合できる形で保存しなければならない",
  "inputs": [
    "保存対象とそのidentity",
    "機微情報検査結果",
    "REQ-PORTABLE-002およびREQ-PORTABLE-004を満たす共有保存境界",
    "許可された保存形式、アクセス境界およびretention policy"
  ],
  "outputs": [
    "保存結果と再読込照合結果",
    "耐久的に確定した成果物"
  ],
  "stop_conditions": [
    "保存先のアクセス境界を確認できない",
    "原子的な確定または再読込照合に失敗する",
    "機微情報検査が失敗する"
  ],
  "recovery_conditions": [
    "不完全な一時成果を確定扱いせず直前の確認済み版から再試行する",
    "機微情報を除去し新しい保存試行として記録する"
  ],
  "preserved_artifacts": [
    "直前の確認済み版と値を含まない失敗診断"
  ],
  "acceptance_criteria": [
    "クラッシュ後も確定済み版と未確定版を機械的に識別でき再読込Digestが一致する",
    "削除時も対象identity、理由および削除結果のDigest付き診断が残る",
    "書込み途中の強制終了後も直前の確認済み版が変わらない"
  ],
  "non_goals": [
    "保存失敗を無視して後続処理を続けること",
    "未検査の失敗材料を恒久保存すること"
  ],
