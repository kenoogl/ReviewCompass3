  "protocols": [
    {
      "protocol_id": "PROTOCOL-RUN-START",
      "steps": [
        "Review ContextをTask、active work、Context digest、freshness verdictおよびExecution Spec digestへ束縛する",
        "Workflowが束縛値を含む単回Run permitを耐久化する",
        "Harnessが外部送信直前にpermitと全束縛値を再検証する",
        "不一致、期限切れまたは再利用をblockedとして保存し外部送信しない"
      ]
    },
    {
      "protocol_id": "PROTOCOL-FINDING-FINALIZATION",
      "steps": [
        "Harnessの検証済み結果からFinding候補を構成し内容Digestで凍結する",
        "Semantic Traceが凍結候補と入力・Attempt・Validationの来歴を検証してpre-provenance verdictを保存する",
        "pre-provenance合格後にだけHumanが採用、拒否または保留を判断する",
        "Human判断を候補Digestへ束縛してFinal Finding候補を保存する",
        "Semantic TraceがFinal Findingまでの来歴を再検証してfinal provenance verdictを保存する",
        "Workflowはfinal provenance合格後にだけRunと段階を完了する"
      ]
    },
    {
      "protocol_id": "PROTOCOL-IMPROVEMENT-CYCLE",
      "steps": [
        "Evidence Evaluationが固定測定条件と観測値を評価Packageへ固定する",
        "Self Improvementが評価Packageから改善仮説を生成し固定条件で比較する",
        "Human承認済みのpolicy changeだけを版付き変更提案としてWorkflowへ渡す",
        "Workflowが次周期の開始時に変更提案の版、Digestおよび適用範囲を検証する"
      ]
    }
  ],
