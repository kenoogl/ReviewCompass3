  "state_machines": [
    {
      "machine_id": "SM-WORKFLOW",
      "owner_design_id": "DES-WORKFLOW-CONTROL",
      "states": [
        "idle",
        "ready",
        "running",
        "awaiting_final_provenance",
        "blocked",
        "completed"
      ],
      "events": [
        "prepare",
        "permit",
        "execution_finished",
        "execution_failed",
        "execution_rejected",
        "provenance_passed",
        "provenance_failed",
        "invalidate",
        "reopen"
      ],
      "transitions": [
        {
          "from": "idle",
          "event": "prepare",
          "to": "ready",
          "guard": "開始要求、Context、Specおよびactive workが一致する",
          "persistence": "検査済み開始要求をpermit発行前に保存する"
        },
        {
          "from": "ready",
          "event": "permit",
          "to": "running",
          "guard": "単回permitが承認済み開始要求へ完全に束縛される",
          "persistence": "permitと消費前状態を外部送信前に保存する"
        },
        {
          "from": "ready",
          "event": "invalidate",
          "to": "blocked",
          "guard": "Context、Specまたはactive workが変更された",
          "persistence": "permit無効化と理由を保存する"
        },
        {
          "from": "running",
          "event": "execution_finished",
          "to": "awaiting_final_provenance",
          "guard": "Harness結果がrun、permit、active workへ一致する",
          "persistence": "Run結果をfinal verdict待ちより先に保存する"
        },
        {
          "from": "running",
          "event": "execution_failed",
          "to": "blocked",
          "guard": "Harnessがfailedまたはirrecoverableを返した",
          "persistence": "失敗結果とblocked状態を原子的に保存する"
        },
        {
          "from": "running",
          "event": "execution_rejected",
          "to": "blocked",
          "guard": "開始後の関門がRunを拒否した",
          "persistence": "拒否理由とblocked状態を原子的に保存する"
        },
        {
          "from": "running",
          "event": "provenance_failed",
          "to": "blocked",
          "guard": "pre-provenanceが不合格である",
          "persistence": "pre不合格とRun停止を原子的に保存する"
        },
        {
          "from": "awaiting_final_provenance",
          "event": "provenance_passed",
          "to": "completed",
          "guard": "Final Findingへ束縛されたfinal verdictが合格である",
          "persistence": "final verdictを完了状態より先に保存する"
        },
        {
          "from": "awaiting_final_provenance",
          "event": "provenance_failed",
          "to": "blocked",
          "guard": "final verdictが不合格または未解決である",
          "persistence": "不合格理由とblocked状態を原子的に保存する"
        },
        {
          "from": "blocked",
          "event": "reopen",
          "to": "ready",
          "guard": "訂正済みContextまたはSpecを新しい版で承認した",
          "persistence": "旧失敗を保持し新しい開始要求を別版として保存する"
        }
      ]
    },
