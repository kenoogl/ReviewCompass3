  "decision": {
    "approved_for_documentation": true,
    "decided_at": "2026-08-02",
    "decision_maker": "human_user",
    "instructions": [
      {
        "decision_id": "TC-LANE-DEC-001",
        "meaning": "SDDとmaintenanceをwork origin、reopenをcontinuation modeとして共通Task Contract Deliveryへ統合する",
        "text": "タスクコントラクト型のレビューシステムでは、この3つの開発レーンは継続して必要になるか。"
      },
      {
        "decision_id": "TC-LANE-DEC-002",
        "meaning": "TDD中の上流不整合を分類し、確定済み成果を上書きせず新versionへ戻す",
        "text": "上流のリクワイアメントに遡って修正が発生する。こういった場合にはどうしたらよいか。"
      },
      {
        "decision_id": "TC-LANE-DEC-003",
        "meaning": "実装困難時のpause、cancel、close-scopeを制御された終了として扱う",
        "text": "KDDのサイクルは、何かの困難でその実装を中止する判断が発生する場合もある。"
      },
      {
        "decision_id": "TC-LANE-DEC-004",
        "meaning": "入れ子問題を永続依存graphへ平坦化し、単一active leaf、循環停止、解消判断を導入する",
        "text": "依存関係、循環が発生してしまい、TDD開発を続けられなくなる。こういうことも発生する。"
      },
      {
        "decision_id": "TC-LANE-DEC-005",
        "meaning": "開発レーンに関する一連の検討を後継候補文書へ反映する",
        "text": "以上，議論した開発レーンの検討内容を整理し、文書に反映する。"
      }
    ],
