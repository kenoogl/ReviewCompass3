    {
      "id": "RR-001",
      "resolution": "source universe identityと完全性判定結果をExecution Context identityへ含め、source universe変更を新Review Run開始条件へ追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-002",
      "resolution": "Toolの責務分類と決定性を分離し、非決定的Toolの入力・版・環境・出力・Validation・Retryを来歴対象にした",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-003",
      "resolution": "外部provenance referenceへ対象identity、内容Digest、解決規則、信頼境界、検証結果、失敗時停止を追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-004",
      "resolution": "serialized outbound payloadを確定した後、同じDigestを機微情報検査・Human承認・送信Attemptへ結ぶ順序へ修正した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-005",
      "resolution": "承認済み閉鎖payloadを承認フラグと対象Digestが一致する閉鎖payloadへ改め、Human承認証跡ではないことを明示した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-006",
      "resolution": "検証コマンド、対象範囲、環境、終了コード、収集数、出力Digestを独立verification記録へ固定した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "RR-007",
      "resolution": "機械処理の決定性を同一の機械入力に限定し、LLM後段ではraw応答を入力へ含める表現へ修正した",
      "status": "applied_pending_rereview"
    }
