    {
      "id": "IR-001",
      "resolution": "intentを利用者価値と不変原則へ寄せ、詳細な記録候補と同一性境界は概念文書へ分離した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-002",
      "resolution": "汎用エージェント基盤とLLMによる完全自律的な計画・完了判断を対象外へ追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-003",
      "resolution": "完全性を固定source universeとScope contractに対する保証へ限定した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-004",
      "resolution": "Findingの主張とHuman decisionからExecution Context内の証拠単位への参照と検査を追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-005",
      "resolution": "Digestの保証範囲を限定し、Execution Context identityとeffective execution identityを分離した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-006",
      "resolution": "固定commit、実装箇所、テストを結ぶevidenceを作成し、不変保存をwrite-once APIとDigest付与へ訂正した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-007",
      "resolution": "Harness contractで固定する実行条件候補を追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-008",
      "resolution": "Toolの分類と、LLM、機械処理、Humanの提案権・決定権・裁定境界を追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-009",
      "resolution": "セッション、変更、成果物へ接続する外部provenance referenceを追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-010",
      "resolution": "Review Run、Attempt、Retry、新Run条件、Finding集合と空集合を定義した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-011",
      "resolution": "成功条件の未達状態を示し、観測量と閾値をrequirementsで定める境界を追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-012",
      "resolution": "外部送信前の機微情報検査と、送信対象Digestに束縛したHuman承認を来歴へ追加した",
      "status": "applied_pending_rereview"
    },
    {
      "id": "IR-013",
      "resolution": "一意ID、内容Digest、限定された平文の関係種別を分離した",
