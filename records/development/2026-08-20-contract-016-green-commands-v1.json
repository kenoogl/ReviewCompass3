    },
    {
      "label": "成果物・受入材料のdigest固定",
      "argv": [
        "shasum", "-a", "256",
        "tools/reviewer_launch/core.py",
        "tools/reviewer_launch/entry.py",
        "tools/request_builder/core.py",
        "tools/request_builder/entry.py",
        "tests/test_reviewer_launch.py",
        "tests/test_request_builder.py",
        "docs/development/prompts/request-builder-run.md",
        "docs/development/prompts/reviewer-launch-run.md",
